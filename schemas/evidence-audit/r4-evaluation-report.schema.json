{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-enterprise.local/schemas/evidence-audit/r4-evaluation-report.schema.json",
  "title": "R4 AI Interpretation Evaluation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "run_id",
    "case_count",
    "passed_count",
    "failed_count",
    "cases",
    "passed",
    "report_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "schema_ref": {
      "const": "schemas/evidence-audit/r4-evaluation-report.schema.json"
    },
    "run_id": { "type": "string", "minLength": 1 },
    "case_count": { "type": "integer", "minimum": 0 },
    "passed_count": { "type": "integer", "minimum": 0 },
    "failed_count": { "type": "integer", "minimum": 0 },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/caseResult" }
    },
    "passed": { "type": "boolean" },
    "report_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "caseResult": {
      "type": "object",
      "required": ["case_id", "run_id"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "result_hash": { "$ref": "#/$defs/sha256" },
        "schema_error": { "type": "string" },
        "metrics": { "type": "object" },
        "expected": { "type": "object" },
        "extraction": { "type": "object" },
        "duplicate_findings": { "type": "array" },
        "adapter_result": { "type": "object" }
      },
      "additionalProperties": true
    }
  }
}
