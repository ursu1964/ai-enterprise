{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-enterprise.local/schemas/evidence-audit/evidence-package.schema.json",
  "title": "BK/R11 Evidence Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_package_id",
    "project_id",
    "package_version",
    "baseline_refs",
    "artifacts",
    "audit_records",
    "coverage",
    "integrity",
    "acceptance_status",
    "blockers",
    "manifest_hash"
  ],
  "properties": {
    "evidence_package_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "package_version": { "const": "evidence-audit-engine-1.0" },
    "baseline_refs": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_artifact" }
    },
    "audit_records": {
      "type": "array",
      "items": { "$ref": "#/$defs/audit_record" }
    },
    "coverage": { "$ref": "#/$defs/coverage_report" },
    "integrity": { "$ref": "#/$defs/integrity_report" },
    "acceptance_status": { "enum": ["accepted", "blocked"] },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "manifest_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_type", "actor_id", "role"],
      "properties": {
        "actor_type": { "type": "string", "minLength": 1 },
        "actor_id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_type", "subject_id", "relationship"],
      "properties": {
        "subject_type": { "type": "string", "minLength": 1 },
        "subject_id": { "type": "string", "minLength": 1 },
        "relationship": { "type": "string", "minLength": 1 }
      }
    },
    "evidence_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "evidence_type",
        "source_system",
        "uri",
        "content_hash",
        "captured_at",
        "captured_by",
        "subjects",
        "classification",
        "retention_class",
        "metadata",
        "artifact_hash"
      ],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "evidence_type": {
          "enum": [
            "test-report",
            "scan-report",
            "review-record",
            "approval-record",
            "runtime-log",
            "deployment-proof",
            "configuration-snapshot",
            "traceability-export",
            "audit-export",
            "policy-decision",
            "waiver-record"
          ]
        },
        "source_system": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "minLength": 1 },
        "content_hash": { "type": "string", "minLength": 1 },
        "captured_at": { "type": "string", "minLength": 1 },
        "captured_by": { "$ref": "#/$defs/actor" },
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/subject" }
        },
        "classification": { "type": "string", "minLength": 1 },
        "retention_class": { "type": "string", "minLength": 1 },
        "metadata": { "type": "object" },
        "artifact_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "audit_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_record_id",
        "stream_id",
        "sequence",
        "previous_hash",
        "event_type",
        "occurred_at",
        "actor",
        "subject",
        "evidence_ids",
        "payload_hash",
        "record_hash"
      ],
      "properties": {
        "audit_record_id": { "type": "string", "minLength": 1 },
        "stream_id": { "type": "string", "minLength": 1 },
        "sequence": { "type": "integer", "minimum": 1 },
        "previous_hash": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "event_type": { "type": "string", "minLength": 1 },
        "occurred_at": { "type": "string", "minLength": 1 },
        "actor": { "$ref": "#/$defs/actor" },
        "subject": { "$ref": "#/$defs/subject" },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "payload_hash": { "$ref": "#/$defs/sha256" },
        "record_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "coverage_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "obligations_total",
        "obligations_satisfied",
        "obligations_blocked",
        "items",
        "coverage_hash"
      ],
      "properties": {
        "status": { "enum": ["satisfied", "blocked"] },
        "obligations_total": { "type": "integer", "minimum": 0 },
        "obligations_satisfied": { "type": "integer", "minimum": 0 },
        "obligations_blocked": { "type": "integer", "minimum": 0 },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/coverage_item" }
        },
        "coverage_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "coverage_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "required_evidence_types",
        "evidence_ids",
        "status",
        "missing_evidence_types"
      ],
      "properties": {
        "obligation_id": { "type": "string", "minLength": 1 },
        "required_evidence_types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "status": { "enum": ["satisfied", "blocked"] },
        "missing_evidence_types": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "integrity_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "stream_count",
        "record_count",
        "failures",
        "integrity_hash"
      ],
      "properties": {
        "status": { "enum": ["verified", "failed"] },
        "stream_count": { "type": "integer", "minimum": 0 },
        "record_count": { "type": "integer", "minimum": 0 },
        "failures": {
          "type": "array",
          "items": { "type": "object" }
        },
        "integrity_hash": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
