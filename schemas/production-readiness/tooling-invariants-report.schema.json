{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-enterprise.local/schemas/production-readiness/tooling-invariants-report.schema.json",
  "title": "Tooling Invariants Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "conformant",
    "checked_tools",
    "checked_actions",
    "findings"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "schema_ref": {
      "const": "schemas/production-readiness/tooling-invariants-report.schema.json"
    },
    "conformant": { "type": "boolean" },
    "checked_tools": { "type": "integer", "minimum": 0 },
    "checked_actions": { "type": "integer", "minimum": 0 },
    "findings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
