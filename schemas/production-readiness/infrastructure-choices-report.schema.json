{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-enterprise.local/schemas/production-readiness/infrastructure-choices-report.schema.json",
  "title": "Infrastructure Choices Verification Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "conformant",
    "path",
    "summary",
    "findings",
    "next_action",
    "schema_version",
    "schema_ref"
  ],
  "properties": {
    "status": { "enum": ["ready", "needs_setup"] },
    "conformant": { "type": "boolean" },
    "path": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "findings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_action": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0" },
    "schema_ref": {
      "const": "schemas/production-readiness/infrastructure-choices-report.schema.json"
    }
  }
}
