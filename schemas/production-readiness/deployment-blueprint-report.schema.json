{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-enterprise.local/schemas/production-readiness/deployment-blueprint-report.schema.json",
  "title": "Deployment Blueprint Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "status",
    "business_meaning",
    "next_action",
    "phases",
    "artifacts",
    "missing",
    "schema_version",
    "schema_ref"
  ],
  "properties": {
    "name": { "const": "AI Enterprise Deployment Blueprint" },
    "status": { "enum": ["ready", "needs_setup"] },
    "business_meaning": { "type": "string", "minLength": 1 },
    "next_action": { "type": "string", "minLength": 1 },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/phase" }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/artifact" }
    },
    "missing": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "schema_version": { "const": "1.0" },
    "schema_ref": {
      "const": "schemas/production-readiness/deployment-blueprint-report.schema.json"
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "name", "gate", "proof"],
      "properties": {
        "phase": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "gate": { "type": "string", "minLength": 1 },
        "proof": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "exists"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "exists": { "type": "boolean" }
      }
    }
  }
}
