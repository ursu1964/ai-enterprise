{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-enterprise.local/schemas/production-readiness/model-endpoint-verification-report.schema.json",
  "title": "Model Endpoint Verification Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conformant",
    "endpoint",
    "model",
    "findings",
    "schema_version",
    "schema_ref"
  ],
  "properties": {
    "conformant": { "type": "boolean" },
    "endpoint": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "available_models": {
      "type": "array",
      "items": { "type": "string" }
    },
    "findings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "schema_version": { "const": "1.0" },
    "schema_ref": {
      "const": "schemas/production-readiness/model-endpoint-verification-report.schema.json"
    }
  }
}
