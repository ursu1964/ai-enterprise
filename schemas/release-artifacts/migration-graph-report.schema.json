{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-enterprise.local/schemas/release-artifacts/migration-graph-report.schema.json",
  "title": "Migration Graph Verification Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "conformant",
    "migration_count",
    "base_revisions",
    "head_revisions",
    "rollback_feasible_count",
    "findings"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "schema_ref": {
      "const": "schemas/release-artifacts/migration-graph-report.schema.json"
    },
    "conformant": { "type": "boolean" },
    "migration_count": { "type": "integer", "minimum": 0 },
    "base_revisions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "head_revisions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "rollback_feasible_count": { "type": "integer", "minimum": 0 },
    "findings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
