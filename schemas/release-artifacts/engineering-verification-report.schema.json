{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-enterprise.local/schemas/release-artifacts/engineering-verification-report.schema.json",
  "title": "Engineering Verification Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conformant",
    "checks",
    "evidence_hash",
    "findings",
    "schema_version",
    "schema_ref"
  ],
  "properties": {
    "conformant": { "type": "boolean" },
    "checks": { "type": "integer", "minimum": 0 },
    "evidence_hash": { "$ref": "#/$defs/sha256" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "schema_version": { "const": "1.0" },
    "schema_ref": {
      "const": "schemas/release-artifacts/engineering-verification-report.schema.json"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "path", "message"],
      "properties": {
        "check": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
