{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-enterprise.local/schemas/verification/waiver.schema.json",
  "title": "BK/R10 Verification Waiver",
  "type": "object",
  "required": [
    "waiver_id",
    "obligation_id",
    "authority",
    "justification",
    "risk_acceptance",
    "scope",
    "expires_at",
    "compensating_controls",
    "status",
    "waiver_hash"
  ],
  "properties": {
    "waiver_id": {"type": "string"},
    "verification_campaign_id": {"type": "string"},
    "obligation_id": {"type": "string"},
    "authority": {"type": "object"},
    "justification": {"type": "string", "minLength": 1},
    "risk_acceptance": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string"},
    "compensating_controls": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"enum": ["REQUESTED", "APPROVED", "REJECTED", "REVOKED", "EXPIRED"]},
    "waiver_hash": {"type": "string"}
  },
  "additionalProperties": true
}
