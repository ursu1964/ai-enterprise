{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-enterprise.local/schemas/architecture-baseline/r-series-alignment-report.schema.json",
  "title": "R-Series Alignment Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "r_range",
    "package_count",
    "complete_count",
    "incomplete",
    "capability_area_count",
    "reconciled_capability_area_count",
    "evidence_reference_count",
    "reconciliation_verdict",
    "ir_specification_count",
    "ir_specifications",
    "packages",
    "alignment_hash"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "schema_ref": {
      "const": "schemas/architecture-baseline/r-series-alignment-report.schema.json"
    },
    "r_range": { "const": "R2-R22" },
    "package_count": { "const": 21 },
    "complete_count": { "type": "integer", "minimum": 0, "maximum": 21 },
    "incomplete": {
      "type": "array",
      "items": { "type": "string", "pattern": "^R[0-9]+$" }
    },
    "capability_area_count": { "type": "integer", "minimum": 168 },
    "reconciled_capability_area_count": { "type": "integer", "minimum": 0 },
    "evidence_reference_count": { "type": "integer", "minimum": 1 },
    "reconciliation_verdict": { "enum": ["complete", "incomplete"] },
    "ir_specification_count": { "const": 21 },
    "ir_specifications": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "items": { "$ref": "#/$defs/ir_specification" }
    },
    "packages": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "items": { "$ref": "#/$defs/package" }
    },
    "alignment_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ir_specification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "title", "path"],
      "properties": {
        "document_id": { "type": "string", "pattern": "^R[0-9]+-IR-[0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "path": {
          "type": "string",
          "pattern": "^docs/ir/R[0-9]+-IR-[0-9]+-.+\\.md$"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "p_phase",
        "title",
        "spec_path",
        "spec_hash",
        "package_path",
        "complete",
        "capabilities"
      ],
      "properties": {
        "r": { "type": "string", "pattern": "^R[0-9]+$" },
        "p_phase": { "type": "string", "pattern": "^P[0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "spec_path": { "type": "string", "pattern": "^1/r[0-9]+\\.txt$" },
        "spec_hash": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "package_path": {
          "type": "string",
          "pattern": "^implementation/r[0-9][0-9]$"
        },
        "complete": { "type": "boolean" },
        "capabilities": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/capability" }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "status", "evidence_count"],
      "properties": {
        "category": {
          "enum": [
            "source_specification",
            "domain_or_runtime",
            "api_contract",
            "api_route",
            "persistence_or_migration",
            "schema_or_registry",
            "tests",
            "status_documentation"
          ]
        },
        "status": { "enum": ["implemented", "missing", "verified_not_applicable"] },
        "evidence_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
