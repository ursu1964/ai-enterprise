{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-enterprise.local/schemas/architecture-baseline/roadmap-sequence-gate.schema.json",
  "title": "Roadmap Sequence Gate Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_ref",
    "status",
    "generated_at",
    "r_range",
    "implementation_phase_range",
    "alignment_report_hash",
    "checks",
    "findings",
    "next_action"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "schema_ref": {
      "const": "schemas/architecture-baseline/roadmap-sequence-gate.schema.json"
    },
    "status": { "enum": ["passed", "failed"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "r_range": { "const": "R2-R22" },
    "implementation_phase_range": { "const": "P12-P32" },
    "alignment_report_hash": { "$ref": "#/$defs/sha256" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "next_action": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "summary"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "severity", "message"],
      "properties": {
        "check": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
