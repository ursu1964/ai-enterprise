{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-enterprise.local/schemas/orchestration/approval-gate/1.0",
  "title": "R21 Approval Gate",
  "type": "object",
  "required": ["gate_id", "project_id", "gate_type", "required_approvers", "evidence_required", "status"],
  "properties": {
    "gate_id": {"type": "string"},
    "project_id": {"type": "string"},
    "gate_type": {"type": "string"},
    "required_approvers": {"type": "array", "minItems": 1},
    "evidence_required": {"type": "array"},
    "status": {"enum": ["pending", "approved", "rejected", "expired"]}
  }
}
