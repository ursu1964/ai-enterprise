# Copy to .env for local development. Never commit .env or runtime-data/dev-secrets.env.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://ai_enterprise:ai_enterprise_dev@localhost:5432/ai_enterprise
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ollama/gemma3:12b
ARCHITECTURE_PROVIDER=scripted
REPOSITORY_ALLOWED_ROOT=/home/user/projects
# Generated by `python -m ai_enterprise.bootstrap`; source runtime-data/dev-secrets.env.
TRUSTED_PROXY_HMAC_SECRET=
LOCAL_SIGNING_SECRET=
LOCAL_GIT_REMOTE_URL=file:///absolute/path/to/runtime-data/remotes/ai-enterprise.git
