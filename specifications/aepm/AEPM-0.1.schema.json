{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-enterprise.local/schemas/aepm/0.1",
  "title": "AI Enterprise Project Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_intent",
    "business_outcomes",
    "stakeholders",
    "capabilities",
    "core_processes",
    "business_rules",
    "data_entities",
    "integrations",
    "quality_requirements",
    "constraints",
    "preferred_technology_targets"
  ],
  "properties": {
    "schema_version": {"const": "aepm-0.1"},
    "project_intent": {"$ref": "#/$defs/project_intent"},
    "business_outcomes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/business_outcome"}},
    "stakeholders": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stakeholder"}},
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
    "core_processes": {"type": "array", "items": {"$ref": "#/$defs/core_process"}},
    "business_rules": {"type": "array", "items": {"$ref": "#/$defs/business_rule"}},
    "data_entities": {"type": "array", "items": {"$ref": "#/$defs/data_entity"}},
    "integrations": {"type": "array", "items": {"$ref": "#/$defs/integration"}},
    "quality_requirements": {"type": "array", "items": {"$ref": "#/$defs/quality_requirement"}},
    "constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}},
    "preferred_technology_targets": {"$ref": "#/$defs/technology_targets"}
  },
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1},
    "string_list": {"type": "array", "items": {"$ref": "#/$defs/non_empty_string"}},
    "project_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "problem"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
        "problem": {"type": "string", "minLength": 1, "maxLength": 4000},
        "opportunity": {"type": ["string", "null"], "maxLength": 4000}
      }
    },
    "business_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "indicators"],
      "properties": {
        "id": {"type": "string", "pattern": "^OUT-[0-9]{3}$"},
        "description": {"$ref": "#/$defs/non_empty_string"},
        "indicators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/non_empty_string"}}
      }
    },
    "stakeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "role"],
      "properties": {
        "id": {"type": "string", "pattern": "^STK-[0-9]{3}$"},
        "name": {"$ref": "#/$defs/non_empty_string"},
        "role": {"$ref": "#/$defs/non_empty_string"},
        "responsibilities": {"$ref": "#/$defs/string_list"}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "owner_stakeholder_id"],
      "properties": {
        "id": {"type": "string", "pattern": "^CAP-[0-9]{3}$"},
        "name": {"$ref": "#/$defs/non_empty_string"},
        "description": {"$ref": "#/$defs/non_empty_string"},
        "owner_stakeholder_id": {"type": "string", "pattern": "^STK-[0-9]{3}$"}
      }
    },
    "core_process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "trigger", "outputs"],
      "properties": {
        "id": {"type": "string", "pattern": "^PROC-[0-9]{3}$"},
        "name": {"$ref": "#/$defs/non_empty_string"},
        "description": {"$ref": "#/$defs/non_empty_string"},
        "trigger": {"$ref": "#/$defs/non_empty_string"},
        "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/non_empty_string"}}
      }
    },
    "business_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^RULE-[0-9]{3}$"},
        "description": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "data_entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "owner_stakeholder_id"],
      "properties": {
        "id": {"type": "string", "pattern": "^ENT-[0-9]{3}$"},
        "name": {"$ref": "#/$defs/non_empty_string"},
        "description": {"$ref": "#/$defs/non_empty_string"},
        "owner_stakeholder_id": {"type": "string", "pattern": "^STK-[0-9]{3}$"}
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "system", "purpose", "security_rules"],
      "properties": {
        "id": {"type": "string", "pattern": "^INT-[0-9]{3}$"},
        "name": {"$ref": "#/$defs/non_empty_string"},
        "system": {"$ref": "#/$defs/non_empty_string"},
        "purpose": {"$ref": "#/$defs/non_empty_string"},
        "security_rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/non_empty_string"}}
      }
    },
    "quality_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "description", "acceptance_criteria"],
      "properties": {
        "id": {"type": "string", "pattern": "^QUAL-[0-9]{3}$"},
        "category": {"enum": ["accessibility", "availability", "maintainability", "performance", "privacy", "reliability", "scalability", "security", "usability"]},
        "description": {"$ref": "#/$defs/non_empty_string"},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/non_empty_string"}}
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^CON-[0-9]{3}$"},
        "category": {"enum": ["budget", "compliance", "delivery", "operational", "organizational", "technical"]},
        "description": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "technology_targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frontend", "backend", "database", "queue", "object_storage", "deployment"],
      "properties": {
        "frontend": {"$ref": "#/$defs/string_list"},
        "backend": {"$ref": "#/$defs/string_list"},
        "database": {"$ref": "#/$defs/string_list"},
        "queue": {"$ref": "#/$defs/string_list"},
        "object_storage": {"$ref": "#/$defs/string_list"},
        "deployment": {"$ref": "#/$defs/string_list"}
      }
    }
  }
}
