{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-enterprise.local/schemas/snapshot/0.1",
  "title": "AI Enterprise Project Snapshot v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "project_id",
    "aepm_version",
    "aeir_version",
    "source_model_sha256",
    "object_versions",
    "relationship_versions",
    "status",
    "created_at",
    "snapshot_sha256"
  ],
  "properties": {
    "schema_version": {"const": "aeir-snapshot-0.1"},
    "snapshot_id": {"type": "string", "pattern": "^SNP-[0-9]{4}$"},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "aepm_version": {"const": "0.1"},
    "aeir_version": {"const": "0.1"},
    "source_model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "object_versions": {
      "type": "array",
      "items": {
        "anyOf": [
          {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}:0\\.1\\.0$"},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["object_id", "version"],
            "properties": {
              "object_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
              "version": {"type": ["integer", "string"]}
            }
          }
        ]
      }
    },
    "relationship_versions": {
      "type": "array",
      "items": {
        "anyOf": [
          {"type": "string", "pattern": "^REL-[0-9]{3,6}:0\\.1\\.0$"},
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["relationship_id", "version"],
            "properties": {
              "relationship_id": {"type": "string", "pattern": "^REL-[0-9]{3,6}$"},
              "version": {"type": ["integer", "string"]}
            }
          }
        ]
      }
    },
    "validation_summary": {"type": "object"},
    "status": {"enum": ["draft", "approved"]},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 40},
    "created_by": {"type": "string", "minLength": 1, "maxLength": 200},
    "approved_by": {"type": ["string", "null"]},
    "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
