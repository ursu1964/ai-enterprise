{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-enterprise.local/schemas/aeir/0.1",
  "title": "AI Enterprise Internal Representation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_manifest_sha256",
    "objects",
    "relationships",
    "model_sha256"
  ],
  "properties": {
    "schema_version": {"const": "aeir-0.1"},
    "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "objects": {
      "type": "array",
      "items": {"$ref": "#/$defs/object"},
      "minItems": 1
    },
    "relationships": {
      "type": "array",
      "items": {"$ref": "RELATIONSHIP-0.1.schema.json"}
    },
    "model_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "manifest_sha256", "evidence_references"],
      "properties": {
        "kind": {"enum": ["aepm_manifest", "human_clarification"]},
        "reference": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_references": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "description",
        "status",
        "lifecycle_status",
        "truth_status",
        "approval_status",
        "source",
        "source_refs",
        "evidence_refs",
        "confidence",
        "version",
        "created_at",
        "created_by",
        "updated_at",
        "updated_by",
        "relationship_refs",
        "attributes",
        "metadata"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "type": {
          "enum": [
            "project",
            "intent",
            "outcome",
            "stakeholder",
            "capability",
            "process",
            "requirement",
            "rule",
            "entity",
            "integration",
            "constraint",
            "risk",
            "decision",
            "artifact",
            "relationship"
          ]
        },
        "name": {"type": "string", "minLength": 1, "maxLength": 300},
        "description": {"type": "string", "minLength": 1, "maxLength": 4000},
        "status": {"enum": ["proposed", "inferred", "unverified", "approved", "rejected"]},
        "lifecycle_status": {"enum": ["draft", "active", "deprecated", "archived"]},
        "truth_status": {"enum": ["asserted", "inferred", "assumed", "verified", "disputed"]},
        "approval_status": {"enum": ["not_required", "pending", "approved", "rejected"]},
        "source": {"$ref": "#/$defs/source"},
        "source_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "version": {"const": "0.1.0"},
        "created_at": {"type": "string", "minLength": 1, "maxLength": 40},
        "created_by": {"type": "string", "minLength": 1, "maxLength": 200},
        "updated_at": {"type": "string", "minLength": 1, "maxLength": 40},
        "updated_by": {"type": "string", "minLength": 1, "maxLength": 200},
        "ai_operation": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "model_provider",
                "model_name",
                "operation_type",
                "prompt_version",
                "schema_version",
                "generated_at",
                "input_source_refs",
                "review_required"
              ],
              "properties": {
                "model_provider": {"type": "string", "minLength": 1, "maxLength": 200},
                "model_name": {"type": "string", "minLength": 1, "maxLength": 200},
                "operation_type": {"type": "string", "minLength": 1, "maxLength": 80},
                "prompt_version": {"type": "string", "minLength": 1, "maxLength": 80},
                "schema_version": {"const": "AEIR-0.1"},
                "generated_at": {"type": "string", "minLength": 1, "maxLength": 40},
                "input_source_refs": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1},
                  "minItems": 1
                },
                "review_required": {"type": "boolean"}
              }
            }
          ]
        },
        "relationship_refs": {"type": "array", "items": {"$ref": "#/$defs/identifier"}},
        "attributes": {"type": "object"},
        "metadata": {"type": "object"}
      }
    }
  }
}
