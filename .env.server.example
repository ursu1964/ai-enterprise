# Copy to .env.server on the server. Never commit .env.server.
APP_ENV=production
LOG_LEVEL=INFO

# Database
POSTGRES_DB=ai_enterprise
POSTGRES_USER=ai_enterprise
POSTGRES_PASSWORD=change-me-with-a-long-random-secret
DATABASE_URL=postgresql+asyncpg://ai_enterprise:change-me-with-a-long-random-secret@postgres:5432/ai_enterprise

# Public API is expected to sit behind a reverse proxy with TLS and authentication.
AI_ENTERPRISE_BIND_ADDRESS=127.0.0.1
AI_ENTERPRISE_API_PORT=8000
TRUSTED_PROXY_HMAC_SECRET=change-me-with-a-long-random-secret

# Model service. Use an internal Ollama URL, GPU server URL, or managed provider bridge.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=ollama/gemma3:12b
MODEL_PROVIDER_DEFAULT=ollama
ARCHITECTURE_PROVIDER=crewai-ollama
ARCHITECTURE_MODEL_BASE_URL=http://ollama:11434
REQUIREMENTS_LLM_BASE_URL=http://ollama:11434
DECOMPOSITION_MODEL_BASE_URL=http://ollama:11434

# Server storage roots.
REPOSITORY_ALLOWED_ROOT=/srv/ai-enterprise/workspaces
AI_ENTERPRISE_WORKSPACE_ROOT=/srv/ai-enterprise/workspaces
AI_ENTERPRISE_ARTIFACT_ROOT=/srv/ai-enterprise/artifacts
AI_ENTERPRISE_RUNTIME_ROOT=/srv/ai-enterprise/runtime-data

# Execution/review leasing is fail-closed until an approved restricted executor and
# exact pinned image IDs have passed preflight.
EXECUTION_CONTAINER_PROVIDER=unconfigured
EXECUTION_IMAGE_ID=
REVIEW_IMAGE_ID=

# Optional managed infrastructure hooks. Leave blank for single-server local volumes.
MANAGED_POSTGRES_URL=
OBJECT_STORAGE_PROVIDER=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_KMS_KEY_ID=

# R6 artifact publication backends. Filesystem publication needs only
# AI_ENTERPRISE_ARTIFACT_ROOT. Git/S3/npm require the corresponding runtime tool
# and credentials mounted into the API container.
R6_PUBLICATION_GIT_SSH_CONFIG_PATH=/run/secrets/r6_git_ssh_config
R6_PUBLICATION_AWS_PROFILE=
R6_PUBLICATION_AWS_REGION=
R6_PUBLICATION_NPM_TOKEN=
R6_PUBLICATION_NPMRC_PATH=/run/secrets/r6_npmrc

# R7 runtime provider readiness/integration probes. Secrets should be mounted
# through the server secret manager; do not commit real values here.
R7_RUNTIME_KUBECONFIG_PATH=/run/secrets/r7_kubeconfig
R7_RUNTIME_OPA_URL=
R7_RUNTIME_OPENAI_API_KEY=
R7_RUNTIME_PLUGIN_ROOT=/srv/ai-enterprise/runtime-plugins

# R9 operational/runtime backends. Keep secrets out of these values; use mounted
# credential files, IAM roles, or secret-manager references.
R9_EVENT_BUS_BACKEND=local
R9_EVENT_BUS_ENDPOINT=
R9_EVENT_BUS_TOPIC=
R9_EVENT_BUS_REGION=
R9_EVENT_BUS_CREDENTIALS_REF=
R9_WORKER_FLEET_MANIFEST_PATH=deploy/kubernetes/worker-deployment.yaml
R9_SDK_REGISTRY_BACKEND=filesystem
R9_SDK_REGISTRY_REF=

# R18 generator provider adapters. Live provider calls are disabled by default
# so CI/local orchestration stays deterministic. Enable only when real
# credentials/models are configured and approved for the target environment.
R18_LIVE_PROVIDER_CALLS_ENABLED=false
R18_OPENAI_API_KEY=
R18_OPENAI_MODEL=
R18_OPENAI_BASE_URL=https://api.openai.com/v1/responses
R18_ANTHROPIC_API_KEY=
R18_ANTHROPIC_MODEL=
R18_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
R18_GOOGLE_API_KEY=
R18_GOOGLE_MODEL=
R18_CUSTOM_PROVIDER_API_KEY=
R18_CUSTOM_PROVIDER_MODEL=
R18_CUSTOM_PROVIDER_BASE_URL=
R18_PROVIDER_TIMEOUT_SECONDS=120

# R19 project memory backends. Filesystem + deterministic index is the local
# default. Postgres/vector/custom backends require endpoint, credentials,
# deployment evidence, connectivity evidence, and semantic-index references.
R19_MEMORY_BACKEND=filesystem
R19_MEMORY_SEMANTIC_INDEX_BACKEND=deterministic
R19_MEMORY_ENDPOINT_REF=
R19_MEMORY_DATABASE_REF=
R19_MEMORY_INDEX_REF=
R19_MEMORY_CREDENTIALS_REF=
R19_MEMORY_DEPLOYMENT_EVIDENCE_REF=
R19_MEMORY_CONNECTIVITY_EVIDENCE_REF=
R19_MEMORY_ENCRYPTION_REQUIRED=false
R19_MEMORY_KMS_KEY_REF=
R19_MEMORY_RBAC_POLICY_REF=
R19_MEMORY_RETENTION_POLICY_REF=

# R11 external integration deployment preflight. Keep raw secrets out of these
# values. Credential entries must be secret-manager, mounted-secret, vault, or
# IAM-role references consumed by the governed gateway/runtime.
R11_EXTERNAL_INTEGRATION_MODE=local
R11_EXTERNAL_ENDPOINT_ALLOWLIST=
R11_EXTERNAL_CREDENTIAL_REFS=
R11_PARTNER_TRUST_REFS=
R11_GATEWAY_BASE_URL=
R11_SECRETS_MANAGER_REF=

# Integration credentials must be mounted as Docker secrets or supplied by the server secret manager.
LOCAL_SIGNING_SECRET=change-me-with-a-long-random-secret
LOCAL_GIT_REMOTE_URL=
GITHUB_INTEGRATION_MODE=ssh_or_app
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_TOKEN_FILE=
